{
    "$schema": "https://opencode.ai/config.json",
    "plugin": [
        "@mohak34/opencode-notifier@latest",
        "@dietrichgebert/ponytail"
    ],
    "permission": {
        "external_directory": {
            "*": "ask",
            "/tmp/opencode/*": "allow",
            "~/.config/*": "allow",
            "/nix/*": "allow"
        }
    }
}
