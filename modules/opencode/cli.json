{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "mode": "matugen"
  },
  "keybinds": {
    "leader": "ctrl+x",
    "app.exit": ["<leader>q", "ctrl+o"],
    "session.new": "<leader>c",
    "session.compact": "none",
    "command.palette.show": "<leader>p",
    "agent.cycle": "tab",
    "agent.cycle.reverse": "none",
    "variant.cycle": "shift+tab",
    "variant.list": "<leader>n"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide"
  },
  "animations": true
}
